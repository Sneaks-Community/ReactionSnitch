{
  "name": "reactionsnitch",
  "version": "3.2.1",
  "description": "A Discord bot that posts notifications to a specified channel when someone reacts to a message.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "discord",
    "bot",
    "reactions",
    "notification"
  ],
  "dependencies": {
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-unicorn": "^74.0.0",
    "globals": "^17.9.0",
    "pino-pretty": "^13.1.3"
  },
   "overrides": {
    "brace-expansion": "5.0.9",
    "undici": "6.28.0"
  }
}
