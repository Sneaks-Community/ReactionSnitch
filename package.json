{
  "name": "reactionsnitch",
  "version": "3.2.0",
  "description": "A Discord bot that posts notifications to a specified channel when someone reacts to a message.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "discord",
    "bot",
    "reactions",
    "notification"
  ],
  "dependencies": {
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-n": "^18.0.1",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-unicorn": "^65.0.1",
    "globals": "^17.7.0",
    "pino-pretty": "^13.1.3"
  },
   "overrides": {
    "ws": "8.21.0"
  }
}
