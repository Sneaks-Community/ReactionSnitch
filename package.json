{
  "name": "reactionsnitch",
  "version": "3.2.3",
  "description": "A Discord bot that posts notifications to a specified channel when someone reacts to a message.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "node --watch --env-file-if-exists=.env index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "keywords": [
    "discord",
    "bot",
    "reactions",
    "notification"
  ],
  "dependencies": {
    "discord.js": "^14.27.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0"
  }
}
